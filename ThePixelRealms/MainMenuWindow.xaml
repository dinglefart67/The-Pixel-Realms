<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ThePixelRealms.MainMenuWindow" Title="The Pixel Realms" WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="MainMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image x:Name="ButtonImage" Source="Assets/Menu/MainMenuButton_Unactive.png" Width="240" Height="72" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonImage" Property="Source" Value="Assets/Menu/MainMenuButton_Active.png" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GameModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.025" ScaleY="1.025" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Three-slice button: the 24px left/right caps remain unchanged; only the center stretches. -->
        <Style x:Key="StorySubButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="72" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LeftCap" Grid.Column="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/Menu/MainMenuButton_Unactive.png" Viewbox="0,0,0.1,1" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="Middle" Grid.Column="1">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/Menu/MainMenuButton_Unactive.png" Viewbox="0.1,0,0.8,1" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="RightCap" Grid.Column="2">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/Menu/MainMenuButton_Unactive.png" Viewbox="0.9,0,0.1,1" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" />
                                </Border.Background>
                            </Border>
                            <ContentPresenter Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LeftCap" Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="Assets/Menu/MainMenuButton_Active.png" Viewbox="0,0,0.1,1" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Middle" Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="Assets/Menu/MainMenuButton_Active.png" Viewbox="0.1,0,0.8,1" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="RightCap" Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="Assets/Menu/MainMenuButton_Active.png" Viewbox="0.9,0,0.1,1" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DisplayArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.25" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VoiceButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Image x:Name="VoiceButtonImage" Source="Assets/Menu/VoiceButton.png" Width="24" Height="24" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="VoiceButtonImage" Property="Source" Value="Assets/Menu/VoiceButton_Active.png" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KeyBindingInputButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="106" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Key bindings scrollbar: fresh simple version -->
        <Style x:Key="KeyBindingScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="24" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="24" RenderTransformOrigin="0.5,0.5">
                            <Rectangle x:Name="Middle" Width="24" Margin="0,22,0,22" HorizontalAlignment="Center" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Rectangle.RenderTransform>
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="Assets/Menu/Settings/SideSliderButtonMiddle.png" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" AlignmentX="Left" AlignmentY="Top" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <Image x:Name="Top" Source="Assets/Menu/Settings/SideSliderButtonTop.png" Width="24" Height="24" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Image.RenderTransform>
                            </Image>

                            <Image x:Name="Bottom" Source="Assets/Menu/Settings/SideSliderButtonBottom.png" Width="24" Height="24" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Top" Property="Source" Value="Assets/Menu/Settings/SideSliderButtonTop_Active.png" />
                                <Setter TargetName="Bottom" Property="Source" Value="Assets/Menu/Settings/SideSliderButtonBottom_Active.png" />
                                <Setter TargetName="Middle" Property="Fill">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="Assets/Menu/Settings/SideSliderButtonMiddle_Active.png" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" AlignmentX="Left" AlignmentY="Top" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Top" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bottom" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Middle" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeyBindingScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="24">
                            <Grid Width="16" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="16" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="Assets/Menu/Settings/SideSliderTop.png" Width="16" Height="16" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <Image Grid.Row="1" Source="Assets/Menu/Settings/SideSliderMiddle.png" Width="16" Margin="0,-2,0,-2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <Image Grid.Row="2" Source="Assets/Menu/Settings/SideSliderBottom.png" Width="16" Height="16" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Grid>
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Background="Transparent" BorderThickness="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource KeyBindingScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Background="Transparent" BorderThickness="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid ClipToBounds="True">
        <Canvas x:Name="BackgroundCanvas" ClipToBounds="True">
            <Image x:Name="MainMenuBackground" Source="Assets/Menu/MainMenuBackground.png" Stretch="Fill" Canvas.Left="0" Canvas.Top="-50">
                <Image.Effect>
                    <BlurEffect Radius="50" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
        </Canvas>
        <Grid x:Name="MainMenuView">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0">
                <Image Source="Assets/Menu/TPR_Logo.png" Width="864" Height="444" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,0,150" />
                <Button Content="Játék" Style="{StaticResource MainMenuButtonStyle}" Click="StartGame_Click" />
                <Button Content="Beállítások" Style="{StaticResource MainMenuButtonStyle}" Click="Settings_Click" />
                <Button Content="Súgó" Style="{StaticResource MainMenuButtonStyle}" />
                <Button Content="Kilépés" Style="{StaticResource MainMenuButtonStyle}" Click="Exit_Click" />
            </StackPanel>
            <TextBlock Text="The Pixel Realms™" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="25,0,0,20" Foreground="White" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="v.0.0.1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,20" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </Grid>
        <Grid x:Name="GameModeView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" Margin="0,170,0,170" MouseEnter="Story_MouseEnter" MouseLeave="Story_MouseLeave"
                  ClipToBounds="False" RenderTransformOrigin="0.5,0.5">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.025" ScaleY="1.025" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Button Style="{StaticResource GameModeButtonStyle}" Click="StoryMode_Click" RenderTransform="{x:Null}">
                    <Grid ClipToBounds="False">
                        <Border Margin="8" ClipToBounds="True">
                            <Image x:Name="StoryImage" Source="Assets/Menu/StoryMode.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <Image x:Name="StoryUpLeft" Source="Assets/Menu/BigBorder_UpLeft.png" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StoryUpRight" Source="Assets/Menu/BigBorder_UpRight.png" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StoryDownLeft" Source="Assets/Menu/BigBorder_DownLeft.png" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StoryDownRight" Source="Assets/Menu/BigBorder_DownRight.png" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StoryUp" Source="Assets/Menu/BigBorder_Up.png" Height="20" Margin="18,0,18,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Stretch="Fill" Panel.ZIndex="1" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StoryDown" Source="Assets/Menu/BigBorder_Down.png" Height="20" Margin="18,0,18,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Stretch="Fill" Panel.ZIndex="1" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StoryLeft" Source="Assets/Menu/BigBorder_Left.png" Width="20" Margin="0,18,0,18" HorizontalAlignment="Left" VerticalAlignment="Stretch" Stretch="Fill" Panel.ZIndex="1" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="StoryRight" Source="Assets/Menu/BigBorder_Right.png" Width="20" Margin="0,18,0,18" HorizontalAlignment="Right" VerticalAlignment="Stretch" Stretch="Fill" Panel.ZIndex="1" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <TextBlock x:Name="StoryTitle" Text="STORY MODE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="42" FontWeight="Bold" Panel.ZIndex="3" IsHitTestVisible="False">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="1" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="StoryDescription" Text="Mentsd meg a világot egy hosszú, veszélyekkel és fordulatokkal teli kaland során. Fedezz fel új vidékeket, küzdj félelmetes ellenfelekkel, és tárd fel a világot fenyegető sötétség titkait." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="420" Margin="0,0,0,125" Foreground="White" FontSize="22" FontWeight="SemiBold" Visibility="Collapsed" Panel.ZIndex="3" IsHitTestVisible="False">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="1" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Button>
                <Grid x:Name="StorySubButtons" VerticalAlignment="Bottom" Margin="24,0,24,28"
                      Visibility="Collapsed" Panel.ZIndex="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Új Játék" Style="{StaticResource StorySubButtonStyle}"
                            HorizontalAlignment="Stretch" Click="StoryMode_Click" />
                    <Button Grid.Column="2" Content="Folytatás" Style="{StaticResource StorySubButtonStyle}"
                            HorizontalAlignment="Stretch" Click="ContinueStory_Click" />
                </Grid>
            </Grid>
            <Button Grid.Column="3" Style="{StaticResource GameModeButtonStyle}" Margin="0,170,0,170" MouseEnter="Arcade_MouseEnter" MouseLeave="Arcade_MouseLeave">
                <Grid ClipToBounds="False">
                    <Border Margin="8" ClipToBounds="True">
                        <Image x:Name="ArcadeImage" Source="Assets/Menu/Arcade.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <Image x:Name="ArcadeUpLeft" Source="Assets/Menu/BigBorder_UpLeft.png" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="ArcadeUpRight" Source="Assets/Menu/BigBorder_UpRight.png" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="ArcadeDownLeft" Source="Assets/Menu/BigBorder_DownLeft.png" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="ArcadeDownRight" Source="Assets/Menu/BigBorder_DownRight.png" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="ArcadeUp" Source="Assets/Menu/BigBorder_Up.png" Height="20" Margin="18,0,18,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Stretch="Fill" Panel.ZIndex="1" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="ArcadeDown" Source="Assets/Menu/BigBorder_Down.png" Height="20" Margin="18,0,18,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Stretch="Fill" Panel.ZIndex="1" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="ArcadeLeft" Source="Assets/Menu/BigBorder_Left.png" Width="20" Margin="0,18,0,18" HorizontalAlignment="Left" VerticalAlignment="Stretch" Stretch="Fill" Panel.ZIndex="1" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="ArcadeRight" Source="Assets/Menu/BigBorder_Right.png" Width="20" Margin="0,18,0,18" HorizontalAlignment="Right" VerticalAlignment="Stretch" Stretch="Fill" Panel.ZIndex="1" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="ArcadeTitle" Text="ARCADE" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="42" FontWeight="Bold" Panel.ZIndex="3" IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="ArcadeDescription" Text="Nem elérhető" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="420" Foreground="White" FontSize="22" FontWeight="SemiBold" Visibility="Collapsed" Panel.ZIndex="3" IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Button>
            <Button Content="Vissza" Grid.ColumnSpan="5" Style="{StaticResource MainMenuButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,55" Click="BackToMainMenu_Click" />
        </Grid>
        <Grid x:Name="SettingsView" Visibility="Collapsed">
            <Grid Width="1500" Height="760" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0">
                <Border Margin="8" Background="#D91A1A1A" />
                <Image Source="Assets/Menu/BigBorder_UpLeft.png" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Image Source="Assets/Menu/BigBorder_UpRight.png" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Image Source="Assets/Menu/BigBorder_DownLeft.png" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Image Source="Assets/Menu/BigBorder_DownRight.png" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Fill" Panel.ZIndex="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
